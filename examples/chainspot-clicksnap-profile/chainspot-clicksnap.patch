+/**
+ * Toph recorder — the in-memory recording implementation of `Trace`.
+ * Builds a `TophTrace` object; serialization (JSON to disk, etc.) is the
+ * harness's job, keeping this module environment-agnostic like the core.
+ */
+
+import type { TophAttrValue, TophEntity, TophEvent, TophGeom, TophTrace, Trace } from './trace';
+
+export interface RecordingTrace extends Trace {
+	/** The trace built so far. Safe to read at any point; owned by this recorder. */
+	readonly trace: TophTrace;
+}
+
+export function createTrace(opts: {
+	pipeline: string;
+	source?: { image: string; widthPx: number; heightPx: number };
+	/** Injected clock so traces stay reproducible in tests. Defaults to `new Date()`. */
+	now?: () => Date;
+}): RecordingTrace {
+	const trace: TophTrace = {
+		version: 1,
+		meta: {
+			pipeline: opts.pipeline,
+			startedAt: (opts.now?.() ?? new Date()).toISOString(),
+			...(opts.source ? { source: opts.source } : {})
+		},
+		stages: [],
+		entities: [],
+		events: []
+	};
+
+	const ids = new WeakMap<object, number>();
+	let nextEntityId = 1;
+	let currentStage = 0;
+	const entityById = new Map<number, TophEntity>();
+
+	function pushCheck(
+		e: number,
+		name: string,
+		op: 'gte' | 'lte' | 'range' | 'eq' | 'custom',
+		pass: boolean,
+		value?: number,
+		min?: number,
+		max?: number
+	): boolean {
+		trace.events.push({
+			t: 'check',
+			stage: currentStage,
+			entity: e,
+			name,
+			op,
+			...(value !== undefined ? { value } : {}),
+			...(min !== undefined ? { min } : {}),
+			...(max !== undefined ? { max } : {}),
+			pass
+		} as TophEvent);
+		if (!pass) {
+			trace.events.push({ t: 'decide', stage: currentStage, entity: e, outcome: 'rejected', at: name });
+		}
+		return pass;
+	}
+
+	return {
+		enabled: true,
+		trace,
+		stage(name: string): number {
+			const id = trace.stages.length + 1;
+			trace.stages.push({ id, name, seq: id });
+			currentStage = id;
+			return id;
+		},
+		spawn(kind, obj, opts2): number {
+			const id = nextEntityId;
+			nextEntityId += 1;
+			const entity: TophEntity = {
+				id,
+				kind,
+				stage: currentStage,
+				space: opts2?.space ?? 'source',
+				...(opts2?.geom ? { geom: opts2.geom } : {}),
+				...(opts2?.attrs ? { attrs: { ...opts2.attrs } } : {})
+			};
+			trace.entities.push(entity);
+			entityById.set(id, entity);
+			if (obj) ids.set(obj, id);
+			return id;
+		},
+		idOf(obj: object): number {
+			return ids.get(obj) ?? 0;
+		},
+		attrs(e: number, attrs: Record<string, TophAttrValue>): void {
+			const entity = entityById.get(e);
+			if (!entity) return;
+			entity.attrs = { ...entity.attrs, ...attrs };
+		},
+		gte: (e, name, value, min) => pushCheck(e, name, 'gte', value >= min, value, min),
+		lte: (e, name, value, max) => pushCheck(e, name, 'lte', value <= max, value, undefined, max),
+		range: (e, name, value, min, max) =>
+			pushCheck(e, name, 'range', value >= min && value <= max, value, min, max),
+		check: (e, name, pass, value) => pushCheck(e, name, 'custom', pass, value),
+		measure(e, name, value): void {
+			trace.events.push({ t: 'measure', stage: currentStage, entity: e, name, value });
+		},
+		keep(e, obj): void {
+			trace.events.push({ t: 'decide', stage: currentStage, entity: e, outcome: 'kept' });
+			if (obj) ids.set(obj, e);
+		},
+		reject(e, at): void {
+			trace.events.push({ t: 'decide', stage: currentStage, entity: e, outcome: 'rejected', at });
+		},
+		decide(e, outcome, info): void {
+			const { by, rank, ...rest } = info ?? {};
+			const cleaned: Record<string, TophAttrValue> = {};
+			for (const [key, value] of Object.entries(rest)) {
+				if (value !== undefined) cleaned[key] = value;
+			}
+			trace.events.push({
+				t: 'decide',
+				stage: currentStage,
+				entity: e,
+				outcome,
+				...(by !== undefined ? { by } : {}),
+				...(rank !== undefined ? { rank } : {}),
+				...(Object.keys(cleaned).length > 0 ? { info: cleaned } : {})
+			} as TophEvent);
+		},
+		assign(e, target, outcome, evidence): void {
+			trace.events.push({
+				t: 'assign',
+				stage: currentStage,
+				entity: e,
+				target,
+				outcome,
+				...(evidence ? { evidence } : {})
+			});
+		}
+	};
+}
