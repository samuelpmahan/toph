@@ -0,0 +1,139 @@
+/**
+ * Toph core — the vertical-slice `Trace` interface from
+ * `samuelpmahan/toph` DESIGN.md, hosted in-repo as its first consumer
+ * (clickSnap profiling). Environment-agnostic: no fs, no DOM, no OpenCV.
+ *
+ * Contract highlights (see DESIGN.md Part 3):
+ *  - Entities are Toph-assigned integer IDs; events reference them.
+ *  - Gate helpers (`gte`/`lte`/`range`/`check`) return the boolean so
+ *    production control flow is unchanged; a failed gate auto-records
+ *    `decide { outcome: 'rejected', at: <gate name> }`.
+ *  - Short-circuited gates simply have no events — the honest
+ *    "NOT EVALUATED" representation.
+ *  - `NOOP` is a frozen singleton whose gates are bare comparisons, so an
+ *    uninstrumented caller pays a monomorphic call and nothing else.
+ */
+
+export interface TophGeom {
+	readonly x: number;
+	readonly y: number;
+	readonly w?: number;
+	readonly h?: number;
+	readonly angleDeg?: number;
+}
+
+export type TophAttrValue = number | string | boolean;
+
+export interface TophStageInvocation {
+	readonly id: number;
+	readonly name: string;
+	readonly seq: number;
+}
+
+export interface TophEntity {
+	readonly id: number;
+	readonly kind: string;
+	readonly stage: number;
+	readonly space: string;
+	geom?: TophGeom;
+	attrs?: Record<string, TophAttrValue>;
+}
+
+export type TophEvent =
+	| {
+			readonly t: 'check';
+			readonly stage: number;
+			readonly entity: number;
+			readonly name: string;
+			readonly op: 'gte' | 'lte' | 'range' | 'eq' | 'custom';
+			readonly value?: number;
+			readonly min?: number;
+			readonly max?: number;
+			readonly pass: boolean;
+	  }
+	| {
+			readonly t: 'decide';
+			readonly stage: number;
+			readonly entity: number;
+			readonly outcome: 'kept' | 'rejected' | 'suppressed' | 'ranked-out' | 'lost-contention' | 'selected';
+			readonly at?: string;
+			readonly by?: number;
+			readonly rank?: number;
+			readonly info?: Record<string, TophAttrValue>;
+	  }
+	| {
+			readonly t: 'measure';
+			readonly stage: number;
+			readonly entity: number;
+			readonly name: string;
+			readonly value: number;
+	  }
+	| {
+			readonly t: 'assign';
+			readonly stage: number;
+			readonly entity: number;
+			readonly target: { readonly kind: string; readonly key: string | number };
+			readonly outcome: string;
+			readonly evidence?: Record<string, number>;
+	  };
+
+export interface TophTrace {
+	readonly version: 1;
+	readonly meta: {
+		readonly pipeline: string;
+		readonly startedAt: string;
+		readonly source?: { readonly image: string; readonly widthPx: number; readonly heightPx: number };
+	};
+	readonly stages: TophStageInvocation[];
+	readonly entities: TophEntity[];
+	readonly events: TophEvent[];
+}
+
+export interface Trace {
+	readonly enabled: boolean;
+	/** Opens a new stage invocation; returns its id. Repeated names are distinct invocations. */
+	stage(name: string): number;
+	spawn(
+		kind: string,
+		obj?: object,
+		opts?: { space?: string; geom?: TophGeom; attrs?: Record<string, TophAttrValue> }
+	): number;
+	idOf(obj: object): number;
+	attrs(e: number, attrs: Record<string, TophAttrValue>): void;
+	gte(e: number, name: string, value: number, min: number): boolean;
+	lte(e: number, name: string, value: number, max: number): boolean;
+	range(e: number, name: string, value: number, min: number, max: number): boolean;
+	check(e: number, name: string, pass: boolean, value?: number): boolean;
+	measure(e: number, name: string, value: number): void;
+	keep(e: number, obj?: object): void;
+	reject(e: number, at: string): void;
+	decide(
+		e: number,
+		outcome: 'suppressed' | 'ranked-out' | 'lost-contention' | 'selected',
+		info?: { by?: number; rank?: number } & Record<string, TophAttrValue | undefined>
+	): void;
+	assign(
+		e: number,
+		target: { kind: string; key: string | number },
+		outcome: string,
+		evidence?: Record<string, number>
+	): void;
+}
+
+/** Zero-cost disabled trace: gates are bare comparisons, everything else is a no-op. */
+export const NOOP: Trace = Object.freeze<Trace>({
+	enabled: false,
+	stage: () => 0,
+	spawn: () => 0,
+	idOf: () => 0,
+	attrs: () => undefined,
+	gte: (_e, _n, value, min) => value >= min,
+	lte: (_e, _n, value, max) => value <= max,
+	range: (_e, _n, value, min, max) => value >= min && value <= max,
+	check: (_e, _n, pass) => pass,
+	measure: () => undefined,
+	keep: () => undefined,
+	reject: () => undefined,
+	decide: () => undefined,
+	assign: () => undefined
+});
