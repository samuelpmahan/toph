@@ -0,0 +1,52 @@
+import { readFileSync } from 'node:fs';
+import { extname } from 'node:path';
+import jpeg from 'jpeg-js';
+import { PNG } from 'pngjs';
+import { proposeSingleImageCrop } from '../src/lib/stitch/autoCrop';
+
+/** One-off: does the production single-image autocrop reproduce the frame each corpus annotation was made in? */
+const pairs: readonly { name: string; image: string; annotation: string }[] = JSON.parse(
+	readFileSync(process.argv[2], 'utf8')
+);
+
+for (const pair of pairs) {
+	const bytes = new Uint8Array(readFileSync(pair.image));
+	const ext = extname(pair.image).toLowerCase();
+	const decoded =
+		ext === '.png'
+			? (() => {
+					const png = PNG.sync.read(Buffer.from(bytes));
+					return { rgba: new Uint8Array(png.data), width: png.width, height: png.height };
+				})()
+			: (() => {
+					const jpg = jpeg.decode(Buffer.from(bytes), { useTArray: true });
+					return { rgba: new Uint8Array(jpg.data), width: jpg.width, height: jpg.height };
+				})();
+	const gray = new Uint8Array(decoded.width * decoded.height);
+	for (let pixel = 0, offset = 0; pixel < gray.length; pixel += 1, offset += 4) {
+		gray[pixel] =
+			(decoded.rgba[offset] * 0.299 +
+				decoded.rgba[offset + 1] * 0.587 +
+				decoded.rgba[offset + 2] * 0.114 +
+				0.5) |
+			0;
+	}
+	const proposal = proposeSingleImageCrop({
+		widthPx: decoded.width,
+		heightPx: decoded.height,
+		gray,
+		scale: 1
+	});
+	const annotation = JSON.parse(readFileSync(pair.annotation, 'utf8')) as {
+		sourceImage?: { widthPx?: number; heightPx?: number };
+	};
+	const expectedHeight = annotation.sourceImage?.heightPx ?? null;
+	const croppedHeight = proposal.insets
+		? decoded.height - proposal.insets.topPx - proposal.insets.bottomPx
+		: decoded.height;
+	console.log(
+		`${pair.name}: raw ${decoded.width}x${decoded.height} -> insets ${JSON.stringify(proposal.insets)} ` +
+			`(${proposal.confidence}) croppedHeight=${croppedHeight} annotationExpects=${expectedHeight} ` +
+			(expectedHeight === croppedHeight ? 'MATCH' : 'MISMATCH')
+	);
+}
diff --git a/scripts/profile-click-snap.ts b/scripts/profile-click-snap.ts
new file mode 100644
index 0000000..6a4efff
--- /dev/null
+++ b/scripts/profile-click-snap.ts
@@ -0,0 +1,418 @@
+import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from 'node:fs';
+import { basename, extname, join, resolve } from 'node:path';
+import jpeg from 'jpeg-js';
+import { PNG } from 'pngjs';
+import { loadCv } from '../src/lib/stitch/cvMatch';
+import { detectCalibratedHoleNumberBadges } from '../src/lib/autoAnnotation/cvCalibratedDetectors';
+import {
+	deriveBasketTemplateScale,
+	deriveUDiscCalibration,
+	validateCvTemplateManifest
+} from '../src/lib/autoAnnotation/cvCalibration';
+import type { CvTemplateManifest } from '../src/lib/autoAnnotation/cvCalibration';
+import type { BasketCv, BasketTemplateRaster } from '../src/lib/autoAnnotation/basketTemplateDetection';
+import type { TeePadCv } from '../src/lib/autoAnnotation/teePadDetection';
+import type { HoleNumberCvModule, HoleNumberTemplate } from '../src/lib/autoAnnotation/holeNumberDetection';
+import { proposeSingleImageCrop } from '../src/lib/stitch/autoCrop';
+import { localFeatureSnap } from '../src/lib/cv/localSnap';
+import type { LocalSnapCalibration, LocalSnapKind, LocalSnapRaster } from '../src/lib/cv/localSnap';
+import { createTrace } from '../src/lib/toph/record';
+import type { TophEvent } from '../src/lib/toph/trace';
+
+/**
+ * Toph-instrumented clickSnap (localFeatureSnap) profiler.
+ *
+ * For every annotated corpus course, simulates user clicks at each hole's
+ * ground-truth tee/basket center plus rings of offset clicks, runs the exact
+ * production snap path (calibration derived from the image's own number-badge
+ * anchor, exactly like `basketDetection.worker.ts`'s `detectLocalSnap`), and
+ * reports: did the snap fire, where did it land relative to ground truth, and
+ * — when it didn't fire — which named gate rejected it (from the Toph trace,
+ * not inference).
+ *
+ * Usage:
+ *   npx tsx scripts/profile-click-snap.ts --corpus <dir with <Course>/<Course>-full.* + .annotation.json> --out <dir>
+ */
+
+interface DecodedRaster {
+	readonly rgba: Uint8Array;
+	readonly widthPx: number;
+	readonly heightPx: number;
+}
+
+interface TruthObject {
+	readonly holeNumber: number;
+	readonly kind: LocalSnapKind;
+	readonly xPx: number;
+	readonly yPx: number;
+}
+
+interface ClickResult {
+	readonly holeNumber: number;
+	readonly kind: LocalSnapKind;
+	readonly offsetXPx: number;
+	readonly offsetYPx: number;
+	readonly clickErrorPx: number;
+	readonly snapped: boolean;
+	readonly snapErrorPx: number | null;
+	readonly movedPx: number | null;
+	readonly rejectedAt: string | null;
+	readonly bestScore: number | null;
+	readonly candidateCount: number | null;
+}
+
+const OFFSET_RADII_PX = [4, 8, 12, 16, 20];
+const OFFSET_DIRECTIONS = 8;
+
+function decodeRaster(bytes: Uint8Array, fileName: string): DecodedRaster {
+	const extension = extname(fileName).toLowerCase();
+	if (extension === '.png') {
+		const decoded = PNG.sync.read(Buffer.from(bytes));
+		return { rgba: new Uint8Array(decoded.data), widthPx: decoded.width, heightPx: decoded.height };
+	}
+	if (extension === '.jpg' || extension === '.jpeg') {
+		const decoded = jpeg.decode(Buffer.from(bytes), { useTArray: true });
+		return { rgba: new Uint8Array(decoded.data), widthPx: decoded.width, heightPx: decoded.height };
+	}
+	throw new Error(`Unsupported image format '${extension}'.`);
+}
+
+function toGray(raster: DecodedRaster): Uint8Array {
+	const gray = new Uint8Array(raster.widthPx * raster.heightPx);
+	for (let pixel = 0, offset = 0; pixel < gray.length; pixel += 1, offset += 4) {
+		gray[pixel] =
+			(raster.rgba[offset] * 0.299 +
+				raster.rgba[offset + 1] * 0.587 +
+				raster.rgba[offset + 2] * 0.114 +
+				0.5) |
+			0;
+	}
+	return gray;
+}
+
+function loadValidatedTemplateManifest(templateDir: string): CvTemplateManifest {
+	const manifestPath = join(resolve(templateDir), 'manifest.json');
+	return validateCvTemplateManifest(JSON.parse(readFileSync(manifestPath, 'utf8')));
+}
+
+function loadNumberTemplates(
+	templateDir: string,
+	manifest: CvTemplateManifest
+): readonly HoleNumberTemplate[] {
+	return manifest.templates.holeNumbers.map((fileName, index) => {
+		const path = join(resolve(templateDir), fileName);
+		const decoded = decodeRaster(new Uint8Array(readFileSync(path)), path);
+		return {
+			label: index + 1,
+			raster: { format: 'rgba', widthPx: decoded.widthPx, heightPx: decoded.heightPx, data: decoded.rgba }
+		};
+	});
+}
+
+function loadBasketTemplate(templateDir: string, manifest: CvTemplateManifest): BasketTemplateRaster {
+	const path = join(resolve(templateDir), manifest.templates.basket);
+	const decoded = decodeRaster(new Uint8Array(readFileSync(path)), path);
+	return { gray: toGray(decoded), widthPx: decoded.widthPx, heightPx: decoded.heightPx };
+}
+
+/**
+ * Reproduces the frame a corpus annotation was made in. Several corpus
+ * courses ship the raw phone screenshot while the annotation coordinates are
+ * in the post-autocrop frame (annotation `sourceImage.heightPx` differs from
+ * the shipped image); the production single-image autocrop regenerates that
+ * frame exactly (verified: Lenard 429/278, TowneLake 532/252, Heritage
+ * 429/252 all reproduce the annotated height). Returns the raster unchanged
+ * when the annotation frame already matches.
+ */
+function toAnnotationFrame(
+	image: DecodedRaster,
+	annotationPath: string
+): { raster: DecodedRaster; note: string } {
+	const parsed = JSON.parse(readFileSync(annotationPath, 'utf8')) as {
+		sourceImage?: { widthPx?: number; heightPx?: number };
+	};
+	const expectedWidth = parsed.sourceImage?.widthPx;
+	const expectedHeight = parsed.sourceImage?.heightPx;
+	if (
+		typeof expectedHeight !== 'number' ||
+		expectedHeight === image.heightPx ||
+		expectedWidth !== image.widthPx
+	) {
+		return { raster: image, note: 'annotation frame matches shipped image' };
+	}
+	const gray = toGray(image);
+	const proposal = proposeSingleImageCrop({
+		widthPx: image.widthPx,
+		heightPx: image.heightPx,
+		gray,
+		scale: 1
+	});
+	if (!proposal.insets) {
+		throw new Error(`Annotation frame is ${expectedWidth}x${expectedHeight} but autocrop proposed nothing.`);
+	}
+	const { topPx, bottomPx } = proposal.insets;
+	const croppedHeight = image.heightPx - topPx - bottomPx;
+	if (croppedHeight !== expectedHeight) {
+		throw new Error(
+			`Autocrop produced height ${croppedHeight}, annotation expects ${expectedHeight} — refusing to guess.`
+		);
+	}
+	const rgba = new Uint8Array(image.widthPx * croppedHeight * 4);
+	rgba.set(image.rgba.subarray(topPx * image.widthPx * 4, (topPx + croppedHeight) * image.widthPx * 4));
+	return {
+		raster: { rgba, widthPx: image.widthPx, heightPx: croppedHeight },
+		note: `autocropped top=${topPx} bottom=${bottomPx} to match annotation frame`
+	};
+}
+
+/** Both corpus annotation schemas: bare {course, holes} and schemaVersion-1 {sourceImage, holes}. */
+function loadTruth(annotationPath: string): readonly TruthObject[] {
+	const parsed = JSON.parse(readFileSync(annotationPath, 'utf8')) as {
+		holes?: readonly {
+			number?: number;
+			tee?: { xPx?: number; yPx?: number };
+			basket?: { xPx?: number; yPx?: number };
+		}[];
+	};
+	const objects: TruthObject[] = [];
+	for (const hole of parsed.holes ?? []) {
+		if (typeof hole.number !== 'number') continue;
+		for (const kind of ['tee', 'basket'] as const) {
+			const point = hole[kind];
+			if (typeof point?.xPx === 'number' && typeof point?.yPx === 'number') {
+				objects.push({ holeNumber: hole.number, kind, xPx: point.xPx, yPx: point.yPx });
+			}
+		}
+	}
+	return objects;
+}
+
+function clickOffsets(): readonly { readonly dx: number; readonly dy: number }[] {
+	const offsets: { dx: number; dy: number }[] = [{ dx: 0, dy: 0 }];
+	for (const radius of OFFSET_RADII_PX) {
+		for (let step = 0; step < OFFSET_DIRECTIONS; step += 1) {
+			const angle = (2 * Math.PI * step) / OFFSET_DIRECTIONS;
+			offsets.push({
+				dx: Number((radius * Math.cos(angle)).toFixed(2)),
+				dy: Number((radius * Math.sin(angle)).toFixed(2))
+			});
+		}
+	}
+	return offsets;
+}
+
+function quantile(sorted: readonly number[], q: number): number | null {
+	if (sorted.length === 0) return null;
+	const index = Math.min(sorted.length - 1, Math.floor(q * sorted.length));
+	return Number(sorted[index].toFixed(2));
+}
+
+function summarize(results: readonly ClickResult[]) {
+	const snapped = results.filter((result) => result.snapped);
+	const snapErrors = snapped
+		.map((result) => result.snapErrorPx!)
+		.sort((left, right) => left - right);
+	const rejectedCounts: Record<string, number> = {};
+	for (const result of results) {
+		if (!result.snapped && result.rejectedAt) {
+			rejectedCounts[result.rejectedAt] = (rejectedCounts[result.rejectedAt] ?? 0) + 1;
+		}
+	}
+	const worseCount = snapped.filter((result) => result.snapErrorPx! > result.clickErrorPx + 0.5).length;
+	return {
+		clicks: results.length,
+		snapRate: results.length === 0 ? null : Number((snapped.length / results.length).toFixed(3)),
+		snapErrorMedianPx: quantile(snapErrors, 0.5),
+		snapErrorP90Px: quantile(snapErrors, 0.9),
+		snapErrorMaxPx: quantile(snapErrors, 1),
+		snappedWorseThanRawClick: worseCount,
+		rejections: rejectedCounts
+	};
+}
+
+interface CourseSpec {
+	readonly name: string;
+	readonly imagePath: string;
+	readonly annotationPath: string;
+}
+
+function discoverCourses(corpusDir: string): readonly CourseSpec[] {
+	const root = resolve(corpusDir);
+	const specs: CourseSpec[] = [];
+	for (const entry of readdirSync(root, { withFileTypes: true })) {
+		if (!entry.isDirectory()) continue;
+		const dir = join(root, entry.name);
+		const files = readdirSync(dir);
+		const annotation = files.find((file: string) => file.endsWith('.annotation.json'));
+		const image = files.find((file: string) => /\.(png|jpe?g)$/i.test(file) && !file.endsWith('.annotation.json'));
+		if (annotation && image) {
+			specs.push({ name: entry.name, imagePath: join(dir, image), annotationPath: join(dir, annotation) });
+		}
+	}
+	return specs.sort((left, right) => left.name.localeCompare(right.name));
+}
+
+async function main(): Promise<void> {
+	const argv = process.argv.slice(2);
+	const argValue = (flag: string): string | undefined => {
+		const index = argv.indexOf(flag);
+		return index >= 0 ? argv[index + 1] : undefined;
+	};
+	const corpusDir = argValue('--corpus');
+	if (!corpusDir) throw new Error('Pass --corpus <dir>.');
+	const outputDir = resolve(argValue('--out') ?? '/tmp/clicksnap-profile');
+	const templateDir = argValue('--templates') ?? 'static/resources/chainspot_cv_templates';
+	if (!existsSync(outputDir)) mkdirSync(outputDir, { recursive: true });
+
+	const cv = (await loadCv()) as unknown as TeePadCv & BasketCv & HoleNumberCvModule;
+	const manifest = loadValidatedTemplateManifest(templateDir);
+	const numberTemplates = loadNumberTemplates(templateDir, manifest);
+	const basketTemplate = loadBasketTemplate(templateDir, manifest);
+
+	const report: Record<string, unknown> = {};
+	for (const course of discoverCourses(corpusDir)) {
+		const startedAt = performance.now();
+		const decoded = decodeRaster(new Uint8Array(readFileSync(course.imagePath)), course.imagePath);
+		const { raster: image, note: frameNote } = toAnnotationFrame(decoded, course.annotationPath);
+		const truth = loadTruth(course.annotationPath);
+
+		const numberDetection = detectCalibratedHoleNumberBadges(
+			cv,
+			{ format: 'rgba', widthPx: image.widthPx, heightPx: image.heightPx, data: image.rgba },
+			numberTemplates,
+			{ maxCandidates: 24 }
+		);
+		if (!numberDetection.anchor) {
+			report[course.name] = { error: numberDetection.note ?? 'no number-badge anchor; cannot calibrate' };
+			console.log(`${course.name}: SKIPPED (no badge anchor)`);
+			continue;
+		}
+		const calibration = deriveUDiscCalibration(
+			numberDetection.anchor,
+			manifest.calibration.canonicalNumberBadge
+		);
+		const basketTemplateScale = deriveBasketTemplateScale(
+			numberDetection.anchor.scale,
+			manifest.calibration
+		);
+
+		const teeRaster: LocalSnapRaster = {
+			rgba: image.rgba,
+			widthPx: image.widthPx,
+			heightPx: image.heightPx,
+			sourceScale: 1
+		};
+		const gray = toGray(image);
+		const basketRaster: LocalSnapRaster = {
+			gray,
+			widthPx: image.widthPx,
+			heightPx: image.heightPx,
+			sourceScale: 1
+		};
+		const snapCalibration: Record<LocalSnapKind, LocalSnapCalibration> = {
+			tee: { uiScalePx: calibration.uiScalePx },
+			basket: {
+				uiScalePx: calibration.uiScalePx,
+				basket: { template: basketTemplate, templateScale: basketTemplateScale }
+			}
+		};
+
+		const trace = createTrace({
+			pipeline: 'clickSnap-profile',
+			source: { image: basename(course.imagePath), widthPx: image.widthPx, heightPx: image.heightPx }
+		});
+		const results: ClickResult[] = [];
+		const offsets = clickOffsets();
+		for (const object of truth) {
+			for (const { dx, dy } of offsets) {
+				const clickPx = { xPx: object.xPx + dx, yPx: object.yPx + dy };
+				const eventStart = trace.trace.events.length;
+				const snapped = localFeatureSnap(
+					object.kind,
+					cv,
+					object.kind === 'tee' ? teeRaster : basketRaster,
+					clickPx,
+					snapCalibration[object.kind],
+					trace
+				);
+				const stageId = trace.trace.stages[trace.trace.stages.length - 1]!.id;
+				trace.assign(
+					trace.trace.events
+						.slice(eventStart)
+						.filter((event): event is Extract<TophEvent, { t: 'decide' }> => event.t === 'decide')
+						.find((event) => event.outcome === 'kept')?.entity ?? 0,
+					{ kind: object.kind, key: object.holeNumber },
+					snapped ? 'snap' : 'no-snap',
+					{ truthXPx: object.xPx, truthYPx: object.yPx, stage: stageId }
+				);
+
+				const clickEvents = trace.trace.events.slice(eventStart);
+				const rejection = clickEvents.find(
+					(event): event is Extract<TophEvent, { t: 'decide' }> =>
+						event.t === 'decide' && event.outcome === 'rejected'
+				);
+				const scoreCheck = clickEvents.find(
+					(event): event is Extract<TophEvent, { t: 'check' }> =>
+						event.t === 'check' && event.name === 'score'
+				);
+				const candidateCheck = clickEvents.find(
+					(event): event is Extract<TophEvent, { t: 'check' }> =>
+						event.t === 'check' && event.name === 'candidatesFound'
+				);
+				const clickErrorPx = Math.hypot(dx, dy);
+				results.push({
+					holeNumber: object.holeNumber,
+					kind: object.kind,
+					offsetXPx: dx,
+					offsetYPx: dy,
+					clickErrorPx: Number(clickErrorPx.toFixed(2)),
+					snapped: snapped !== null,
+					snapErrorPx: snapped
+						? Number(Math.hypot(snapped.xPx - object.xPx, snapped.yPx - object.yPx).toFixed(2))
+						: null,
+					movedPx: snapped
+						? Number(Math.hypot(snapped.xPx - clickPx.xPx, snapped.yPx - clickPx.yPx).toFixed(2))
+						: null,
+					rejectedAt: snapped ? null : (rejection?.at ?? 'unknown'),
+					bestScore: scoreCheck?.value !== undefined ? Number(scoreCheck.value.toFixed(3)) : null,
+					candidateCount: candidateCheck?.value ?? null
+				});
+			}
+		}
+
+		const teeResults = results.filter((result) => result.kind === 'tee');
+		const basketResults = results.filter((result) => result.kind === 'basket');
+		const perHole: Record<string, unknown> = {};
+		for (const object of truth) {
+			const holeResults = results.filter(
+				(result) => result.holeNumber === object.holeNumber && result.kind === object.kind
+			);
+			perHole[`${object.kind}-${object.holeNumber}`] = summarize(holeResults);
+		}
+		report[course.name] = {
+			frame: frameNote,
+			uiScalePx: Number(calibration.uiScalePx.toFixed(3)),
+			basketTemplateScale: Number(basketTemplateScale.toFixed(3)),
+			truthObjects: truth.length,
+			tee: summarize(teeResults),
+			basket: summarize(basketResults),
+			perHole,
+			elapsedMs: Math.round(performance.now() - startedAt)
+		};
+		writeFileSync(join(outputDir, `${course.name}-trace.json`), JSON.stringify(trace.trace));
+		writeFileSync(join(outputDir, `${course.name}-clicks.json`), JSON.stringify(results, null, 1));
+		console.log(
+			`${course.name}: tee snapRate=${(report[course.name] as { tee: { snapRate: number | null } }).tee.snapRate} ` +
+				`basket snapRate=${(report[course.name] as { basket: { snapRate: number | null } }).basket.snapRate} ` +
+				`(${Math.round(performance.now() - startedAt)}ms)`
+		);
+	}
+
+	writeFileSync(join(outputDir, 'report.json'), JSON.stringify(report, null, 1));
+	console.log(`\nWrote ${join(outputDir, 'report.json')}`);
+}
+
+main().catch((error) => {
+	console.error(error);
+	process.exit(1);
+});
