{
  "name": "toph",
  "version": "0.1.0",
  "description": "Toph: an evidence-graph observability library for classical CV pipelines.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/runtime/index.js",
  "types": "./dist/runtime/index.d.ts",
  "bin": {
    "toph": "./dist/cli/bin.js"
  },
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    },
    "./run": {
      "types": "./dist/run/index.d.ts",
      "import": "./dist/run/index.js"
    },
    "./evaluation": {
      "types": "./dist/evaluation/index.d.ts",
      "import": "./dist/evaluation/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer/server.d.ts",
      "import": "./dist/viewer/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-static.mjs",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "vitest": "^4.1.10"
  }
}
